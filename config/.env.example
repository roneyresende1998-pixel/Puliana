# Copie este arquivo para config/.env e preencha os valores.
# config/.env NUNCA deve ser comitado (já está no .gitignore).

# Nome do seu agente (Sofia, Nyx, Ava, Puliana...)
AGENT_NAME=Puliana

# Obrigatória — chave da API da Anthropic (Claude)
ANTHROPIC_API_KEY=

# Modelo Claude usado pelo agente
AGENT_MODEL=claude-sonnet-5

# Voz (opcional). Se VOICE_ENABLED=true, ELEVENLABS_API_KEY é obrigatória.
VOICE_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Carteira Solana DEDICADA (nunca use sua carteira principal).
# Aceita base58 (formato Phantom) ou array JSON de bytes (formato solana-keygen).
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Ciclo de mercado atual: bear | bull | neutro
MARKET_CYCLE=neutro

# Portas (opcional, valores padrão abaixo)
BACKEND_PORT=8000
FRONTEND_PORT=5173
